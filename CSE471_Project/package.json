{
  "name": "ashe-pashe",
  "version": "1.0.0",
  "description": "Ashe Pashe - Healthcare Management System",
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev": "concurrently \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "npm run build -w frontend",
    "start:frontend": "npm start -w frontend",
    "start:backend": "npm start -w backend",
    "lint": "npm run lint -w frontend",
    "install-all": "npm install && npm install -w frontend && npm install -w backend"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
